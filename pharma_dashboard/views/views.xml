<odoo>
    <record id="action_pharma_dashboard" model="ir.actions.client">
        <field name="name">لوحة المعلومات</field>
        <field name="tag">pharma_dashboard.main</field>
    </record>
    <record id="view_share_list" model="ir.ui.view">
        <field name="name">pharma.dashboard.share.list</field>
        <field name="model">pharma.dashboard.share</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="partner_id"/>
                <field name="percent"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="action_share" model="ir.actions.act_window">
        <field name="name">حصص الشركاء</field>
        <field name="res_model">pharma.dashboard.share</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_pharma_root" name="لوحة المعلومات" sequence="1"
              web_icon="pharma_dashboard,static/description/icon.png"
              groups="pharma_dashboard.group_dashboard_viewer"/>
    <menuitem id="menu_pharma_main" name="لوحة التحكم" parent="menu_pharma_root"
              action="action_pharma_dashboard" sequence="1"/>
    <menuitem id="menu_pharma_share" name="حصص الشركاء" parent="menu_pharma_root"
              action="action_share" sequence="10"/>
</odoo>
