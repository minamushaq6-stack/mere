<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="pharma_dashboard.BarList">
    <t t-set="mx" t-value="max(items, vkey)"/>
    <div t-if="!items.length" class="pd_empty">لا توجد بيانات في هذه الفترة</div>
    <div t-foreach="items" t-as="i" t-key="i_index" class="pd_row">
        <div class="pd_row_top">
            <span class="pd_name" t-att-class="{pd_link: i.id and link}" t-on-click="() => link and openItems(i.id, i.name, link)" t-esc="i.name"/>
            <span class="pd_val"><t t-esc="fmt(i[vkey])"/></span>
        </div>
        <div class="pd_track"><div t-att-class="'pd_fill ' + tone" t-attf-style="width: #{pct(i[vkey], mx)}%"/></div>
        <div t-if="i.sub" class="pd_sub" t-esc="i.sub"/>
    </div>
</t>

<t t-name="pharma_dashboard.Main">
<div class="o_pharma_db">
    <div class="pd_header">
        <div>
            <h1>لوحة المعلومات</h1>
            <div class="pd_company" t-if="state.data" t-esc="state.data.company"/>
        </div>
        <div class="pd_filters">
            <button t-foreach="periods" t-as="p" t-key="p.id" t-att-class="'pd_chip ' + (state.period === p.id ? 'active' : '')"
                    t-on-click="() => this.setPeriod(p.id)" t-esc="p.label"/>
            <input type="date" t-att-value="state.from" t-on-change="(e) => this.onDate(e, 'from')"/>
            <span>→</span>
            <input type="date" t-att-value="state.to" t-on-change="(e) => this.onDate(e, 'to')"/>
            <button class="pd_chip" t-on-click="() => this.load()" title="تحديث"><i class="fa fa-refresh"/></button>
        </div>
    </div>

    <div class="pd_tabs">
        <button t-foreach="tabs" t-as="t" t-key="t.id" t-att-class="'pd_tab ' + (state.tab === t.id ? 'active' : '')"
                t-on-click="() => state.tab = t.id">
            <i t-att-class="'fa ' + t.icon"/> <t t-esc="t.label"/>
        </button>
    </div>

    <div t-if="state.loading" class="pd_loading"><i class="fa fa-spinner fa-spin fa-2x"/></div>

    <t t-elif="state.data" t-set="d" t-value="state.data">
        <!-- ============ نظرة عامة ============ -->
        <t t-if="state.tab === 'overview'">
            <div class="pd_kpis">
                <div t-foreach="kpis" t-as="k" t-key="k_index" t-att-class="'pd_kpi ' + k.tone" t-on-click="() => state.tab = k.tab">
                    <div class="pd_kpi_icon"><i t-att-class="'fa ' + k.icon"/></div>
                    <div>
                        <div class="pd_kpi_label" t-esc="k.label"/>
                        <div class="pd_kpi_value"><t t-esc="fmt(k.value)"/> <small t-esc="d.currency"/></div>
                        <div class="pd_kpi_sub" t-if="k.sub" t-esc="k.sub"/>
                    </div>
                </div>
            </div>
            <div class="pd_grid two">
                <div class="pd_card">
                    <h3>المبيعات مقابل المشتريات (آخر 12 شهر)</h3>
                    <div class="pd_legend"><span class="dot purple"/> مبيعات <span class="dot orange"/> مشتريات</div>
                    <t t-set="tm" t-value="trendMax()"/>
                    <div class="pd_chart">
                        <div t-foreach="d.trend" t-as="t" t-key="t.m" class="pd_col">
                            <div class="pd_bars">
                                <div class="pd_bar purple" t-attf-style="height: #{pct(t.sales, tm)}%" t-att-title="fmt(t.sales)"/>
                                <div class="pd_bar orange" t-attf-style="height: #{pct(t.purchases, tm)}%" t-att-title="fmt(t.purchases)"/>
                            </div>
                            <div class="pd_lbl" t-esc="t.m.slice(2)"/>
                        </div>
                    </div>
                </div>
                <div class="pd_card">
                    <h3>الصناديق والحسابات البنكية</h3>
                    <t t-call="pharma_dashboard.BarList"><t t-set="items" t-value="d.cash"/><t t-set="vkey" t-value="'value'"/><t t-set="tone" t-value="'teal'"/><t t-set="link" t-value="false"/></t>
                </div>
            </div>
        </t>

        <!-- ============ الصناديق ============ -->
        <t t-if="state.tab === 'cash'">
            <div class="pd_note">اضغط على أي صندوق أو بنك لعرض حركاته التفصيلية. الفترة: <b t-esc="state.from"/> إلى <b t-esc="state.to"/></div>
            <div class="pd_grid two">
                <div t-foreach="d.boxes" t-as="b" t-key="b.id" class="pd_card pd_box" t-on-click="() => this.openBox(b)">
                    <div class="pd_box_top">
                        <h3><i t-att-class="'fa ' + (b.type === 'cash' ? 'fa-inbox' : 'fa-university')"/> <t t-esc="b.name"/></h3>
                        <span class="pd_badge" t-esc="b.type === 'cash' ? 'صندوق' : 'بنك'"/>
                    </div>
                    <div class="pd_box_bal"><t t-esc="fmt(b.balance)"/> <small t-esc="d.currency"/></div>
                    <div class="pd_box_stats">
                        <div><span>رصيد أول الفترة</span><b t-esc="fmt(b.opening)"/></div>
                        <div><span>الداخل</span><b class="pos" t-esc="fmt(b.in)"/></div>
                        <div><span>الخارج</span><b class="neg" t-esc="fmt(b.out)"/></div>
                        <div><span>رواجع زبائن (دفعناها)</span><b class="neg" t-esc="fmt(b.cust_refund)"/></div>
                        <div><span>رواجع موردين (استلمناها)</span><b class="pos" t-esc="fmt(b.supp_refund)"/></div>
                    </div>
                </div>
            </div>
        </t>

        <!-- ============ الذمم ============ -->
        <t t-if="state.tab === 'debts'">
            <div class="pd_grid two">
                <div class="pd_card">
                    <h3>أكثر العملاء مديونية</h3>
                    <div class="pd_note">الإجمالي <b t-esc="fmt(d.receivable.total)"/> — المتأخر <b class="neg" t-esc="fmt(d.receivable.overdue)"/></div>
                    <t t-call="pharma_dashboard.BarList"><t t-set="items" t-value="d.receivable.top"/><t t-set="vkey" t-value="'value'"/><t t-set="tone" t-value="'green'"/><t t-set="link" t-value="\'customer\'"/></t>
                </div>
                <div class="pd_card">
                    <h3>أعمار ديون العملاء</h3>
                    <t t-call="pharma_dashboard.BarList"><t t-set="items" t-value="d.receivable.aging"/><t t-set="vkey" t-value="'value'"/><t t-set="tone" t-value="'orange'"/><t t-set="link" t-value="false"/></t>
                </div>
                <div class="pd_card">
                    <h3>أكثر الموردين مستحقات علينا</h3>
                    <div class="pd_note">الإجمالي <b t-esc="fmt(d.payable.total)"/> — المتأخر <b class="neg" t-esc="fmt(d.payable.overdue)"/></div>
                    <t t-call="pharma_dashboard.BarList"><t t-set="items" t-value="d.payable.top"/><t t-set="vkey" t-value="'value'"/><t t-set="tone" t-value="'red'"/><t t-set="link" t-value="\'supplier\'"/></t>
                </div>
                <div class="pd_card">
                    <h3>أعمار ديون الموردين</h3>
                    <t t-call="pharma_dashboard.BarList"><t t-set="items" t-value="d.payable.aging"/><t t-set="vkey" t-value="'value'"/><t t-set="tone" t-value="'orange'"/><t t-set="link" t-value="false"/></t>
                </div>
            </div>
        </t>

        <!-- ============ المبيعات ============ -->
        <t t-if="state.tab === 'sales'">
            <div class="pd_grid two">
                <div class="pd_card">
                    <h3>الأكثر مبيعاً (بالكمية)</h3>
                    <t t-call="pharma_dashboard.BarList"><t t-set="items" t-value="d.top_products"/><t t-set="vkey" t-value="'qty'"/><t t-set="tone" t-value="'green'"/><t t-set="link" t-value="false"/></t>
                </div>
                <div class="pd_card">
                    <h3>الأقل مبيعاً (بالكمية)</h3>
                    <t t-call="pharma_dashboard.BarList"><t t-set="items" t-value="d.bottom_products"/><t t-set="vkey" t-value="'qty'"/><t t-set="tone" t-value="'red'"/><t t-set="link" t-value="false"/></t>
                </div>
                <div class="pd_card">
                    <h3>الأكثر مبيعاً (بالمبلغ)</h3>
                    <t t-call="pharma_dashboard.BarList"><t t-set="items" t-value="d.top_by_amount"/><t t-set="vkey" t-value="'amount'"/><t t-set="tone" t-value="'purple'"/><t t-set="link" t-value="false"/></t>
                </div>
                <div class="pd_card">
                    <h3>أكثر مورد نبيع من منتجاته</h3>
                    <t t-call="pharma_dashboard.BarList"><t t-set="items" t-value="d.sold_by_supplier"/><t t-set="vkey" t-value="'value'"/><t t-set="tone" t-value="'blue'"/><t t-set="link" t-value="false"/></t>
                </div>
                <div class="pd_card">
                    <h3>أكثر المحافظات شراءً</h3>
                    <t t-call="pharma_dashboard.BarList"><t t-set="items" t-value="d.governorates"/><t t-set="vkey" t-value="'value'"/><t t-set="tone" t-value="'teal'"/><t t-set="link" t-value="false"/></t>
                </div>
                <div class="pd_card">
                    <h3>أفضل العملاء</h3>
                    <t t-call="pharma_dashboard.BarList"><t t-set="items" t-value="d.top_customers"/><t t-set="vkey" t-value="'value'"/><t t-set="tone" t-value="'purple'"/><t t-set="link" t-value="\'customer\'"/></t>
                </div>
                <div class="pd_card">
                    <h3>أكثر الموردين شراءً منهم</h3>
                    <t t-call="pharma_dashboard.BarList"><t t-set="items" t-value="d.top_suppliers"/><t t-set="vkey" t-value="'value'"/><t t-set="tone" t-value="'orange'"/><t t-set="link" t-value="\'supplier\'"/></t>
                </div>
            </div>
        </t>

        <!-- ============ الرواجع ============ -->
        <t t-if="state.tab === 'returns'">
            <t t-set="r" t-value="d.returns"/>
            <div class="pd_kpis small">
                <div class="pd_kpi red"><div><div class="pd_kpi_label">رواجع المبيعات (من الزبائن)</div><div class="pd_kpi_value"><t t-esc="fmt(r.sales.total)"/> <small t-esc="d.currency"/></div><div class="pd_kpi_sub"><t t-esc="r.rate.toFixed(1)"/>% من المبيعات</div></div></div>
                <div class="pd_kpi orange"><div><div class="pd_kpi_label">رواجع المشتريات (للموردين)</div><div class="pd_kpi_value"><t t-esc="fmt(r.purchase.total)"/> <small t-esc="d.currency"/></div></div></div>
            </div>
            <div class="pd_grid two">
                <div class="pd_card"><h3>أكثر المنتجات رجوعاً من الزبائن</h3>
                    <t t-call="pharma_dashboard.BarList"><t t-set="items" t-value="r.sales.products"/><t t-set="vkey" t-value="'value'"/><t t-set="tone" t-value="'red'"/><t t-set="link" t-value="false"/></t></div>
                <div class="pd_card"><h3>أكثر الزبائن إرجاعاً</h3>
                    <t t-call="pharma_dashboard.BarList"><t t-set="items" t-value="r.sales.partners"/><t t-set="vkey" t-value="'value'"/><t t-set="tone" t-value="'red'"/><t t-set="link" t-value="'customer'"/></t></div>
                <div class="pd_card"><h3>المنتجات المرجّعة للموردين</h3>
                    <t t-call="pharma_dashboard.BarList"><t t-set="items" t-value="r.purchase.products"/><t t-set="vkey" t-value="'value'"/><t t-set="tone" t-value="'orange'"/><t t-set="link" t-value="false"/></t></div>
                <div class="pd_card"><h3>الموردون المرجّع لهم</h3>
                    <t t-call="pharma_dashboard.BarList"><t t-set="items" t-value="r.purchase.partners"/><t t-set="vkey" t-value="'value'"/><t t-set="tone" t-value="'orange'"/><t t-set="link" t-value="'supplier'"/></t></div>
            </div>
        </t>

        <!-- ============ المخزون ============ -->
        <t t-if="state.tab === 'stock'">
            <t t-set="inv" t-value="d.inventory"/>
            <div class="pd_kpis small">
                <div class="pd_kpi blue"><div><div class="pd_kpi_label">قيمة المخزون (بالتكلفة)</div><div class="pd_kpi_value"><t t-esc="fmt(inv.total)"/> <small t-esc="d.currency"/></div></div></div>
                <div class="pd_kpi orange"><div><div class="pd_kpi_label">مخزون راكد (لم يُبع بالفترة)</div><div class="pd_kpi_value"><t t-esc="fmt(inv.dead_value)"/> <small t-esc="d.currency"/></div></div></div>
                <div class="pd_kpi red" t-if="inv.has_expiry"><div><div class="pd_kpi_label">منتهي الصلاحية</div><div class="pd_kpi_value"><t t-esc="fmt(inv.expired_val)"/> <small t-esc="d.currency"/></div></div></div>
                <div class="pd_kpi orange" t-if="inv.has_expiry"><div><div class="pd_kpi_label">ينتهي خلال 90 يوم</div><div class="pd_kpi_value"><t t-esc="fmt(inv.near_val)"/> <small t-esc="d.currency"/></div></div></div>
                <div class="pd_kpi red" t-if="inv.negative"><div><div class="pd_kpi_label">أصناف برصيد سالب</div><div class="pd_kpi_value"><t t-esc="inv.negative"/></div></div></div>
            </div>
            <div class="pd_grid two">
                <div class="pd_card">
                    <h3>أعلى الأصناف قيمة في المخزون</h3>
                    <t t-call="pharma_dashboard.BarList"><t t-set="items" t-value="inv.top"/><t t-set="vkey" t-value="'value'"/><t t-set="tone" t-value="'blue'"/><t t-set="link" t-value="false"/></t>
                </div>
                <div class="pd_card">
                    <h3>أصناف راكدة (موجودة وغير مباعة)</h3>
                    <t t-call="pharma_dashboard.BarList"><t t-set="items" t-value="inv.dead"/><t t-set="vkey" t-value="'value'"/><t t-set="tone" t-value="'orange'"/><t t-set="link" t-value="false"/></t>
                </div>
            </div>
            <div class="pd_card" t-if="inv.has_expiry">
                <h3>الأدوية القريبة من الانتهاء / المنتهية</h3>
                <div class="pd_empty" t-if="!inv.expiry.length">لا توجد دفعات قريبة من الانتهاء</div>
                <table class="pd_table" t-else="">
                    <thead><tr><th>المنتج</th><th>الدفعة</th><th>الكمية</th><th>تاريخ الانتهاء</th><th>المتبقي</th></tr></thead>
                    <tbody>
                        <tr t-foreach="inv.expiry" t-as="e" t-key="e_index" t-att-class="e.days &lt; 0 ? 'bad' : (e.days &lt; 30 ? 'warn' : '')">
                            <td t-esc="e.name"/><td t-esc="e.lot"/><td t-esc="fmt(e.qty)"/><td t-esc="e.date"/>
                            <td><t t-if="e.days &lt; 0">منتهي منذ <t t-esc="-e.days"/> يوم</t><t t-else=""><t t-esc="e.days"/> يوم</t></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="pd_note" t-if="!inv.has_expiry">لتفعيل تتبع الصلاحية ثبّت تطبيق <b>product_expiry</b> في أودو.</div>
        </t>

        <!-- ============ الأرباح والشركاء ============ -->
        <t t-if="state.tab === 'partners'">
            <div class="pd_grid two">
                <div class="pd_card">
                    <h3>قائمة الدخل للفترة</h3>
                    <table class="pd_table">
                        <tr><td>الإيرادات</td><td class="num" t-esc="fmt(d.pl.income)"/></tr>
                        <tr><td>تكلفة البضاعة المباعة</td><td class="num neg" t-esc="fmt(d.pl.cogs)"/></tr>
                        <tr class="total"><td>مجمل الربح</td><td class="num" t-esc="fmt(d.pl.gross)"/></tr>
                        <tr><td>المصاريف التشغيلية</td><td class="num neg" t-esc="fmt(d.pl.opex)"/></tr>
                        <tr class="total"><td>صافي الربح</td><td t-att-class="'num ' + (d.pl.net &lt; 0 ? 'neg' : 'pos')" t-esc="fmt(d.pl.net)"/></tr>
                    </table>
                </div>
                <div class="pd_card">
                    <h3>حصص الشركاء من صافي الربح</h3>
                    <div class="pd_empty" t-if="!d.shares.length">أضف الشركاء ونسبهم من القائمة: لوحة المعلومات ← حصص الشركاء</div>
                    <table class="pd_table" t-else="">
                        <thead><tr><th>الشريك</th><th>النسبة</th><th>الحصة</th></tr></thead>
                        <tbody>
                            <tr t-foreach="d.shares" t-as="s" t-key="s_index">
                                <td t-esc="s.name"/><td><t t-esc="s.percent"/>%</td>
                                <td t-att-class="'num ' + (s.amount &lt; 0 ? 'neg' : 'pos')" t-esc="fmt(s.amount)"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </t>
    <div t-if="state.modal" class="pd_overlay" t-on-click.self="() => this.closeModal()">
        <div class="pd_modal">
            <div class="pd_modal_head">
                <h3 t-esc="state.modal.title"/>
                <div>
                    <button t-if="state.modal.kind === 'items'" class="pd_chip" t-on-click="() => this.openPartnerForm(state.modal.partnerId)">فتح البطاقة</button>
                    <button class="pd_chip" t-on-click="() => this.closeModal()"><i class="fa fa-times"/></button>
                </div>
            </div>
            <t t-if="state.modal.kind === 'box'">
                <div class="pd_box_stats in_modal">
                    <div><span>الرصيد الحالي</span><b t-esc="fmt(state.modal.box.balance)"/></div>
                    <div><span>الداخل</span><b class="pos" t-esc="fmt(state.modal.box.in)"/></div>
                    <div><span>الخارج</span><b class="neg" t-esc="fmt(state.modal.box.out)"/></div>
                    <div><span>رواجع زبائن</span><b class="neg" t-esc="fmt(state.modal.box.cust_refund)"/></div>
                    <div><span>رواجع موردين</span><b class="pos" t-esc="fmt(state.modal.box.supp_refund)"/></div>
                </div>
                <div class="pd_empty" t-if="!state.modal.rows.length">لا توجد حركات بهذه الفترة</div>
                <div class="pd_scroll" t-else="">
                    <table class="pd_table">
                        <thead><tr><th>التاريخ</th><th>المرجع</th><th>الجهة</th><th>داخل</th><th>خارج</th></tr></thead>
                        <tbody>
                            <tr t-foreach="state.modal.rows" t-as="m" t-key="m_index" t-att-class="m.tag ? 'warn' : ''">
                                <td t-esc="m.date"/><td t-esc="m.ref"/>
                                <td><t t-esc="m.partner"/> <span t-if="m.tag" class="pd_badge" t-esc="m.tag"/></td>
                                <td class="num pos"><t t-if="m.in" t-esc="fmt(m.in)"/></td>
                                <td class="num neg"><t t-if="m.out" t-esc="fmt(m.out)"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
            <t t-else="">
                <div class="pd_empty" t-if="!state.modal.rows.length">لا توجد فواتير مفتوحة</div>
                <div class="pd_scroll" t-else="">
                    <table class="pd_table">
                        <thead><tr><th>الفاتورة</th><th>التاريخ</th><th>الاستحقاق</th><th>المتبقي</th></tr></thead>
                        <tbody>
                            <tr t-foreach="state.modal.rows" t-as="m" t-key="m_index" t-att-class="m.late ? 'bad' : ''">
                                <td t-esc="m.name"/><td t-esc="m.date"/><td t-esc="m.due"/><td class="num" t-esc="fmt(m.amount)"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </div>
    </div>
</div>
</t>
</templates>
