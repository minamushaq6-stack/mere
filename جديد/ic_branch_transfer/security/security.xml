<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_ic_transfer_company" model="ir.rule">
        <field name="name">Branch transfer: visible to source and destination company</field>
        <field name="model_id" ref="model_ic_stock_transfer"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('dest_company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ic_transfer_line_company" model="ir.rule">
        <field name="name">Branch transfer line: visible to source and destination company</field>
        <field name="model_id" ref="model_ic_stock_transfer_line"/>
        <field name="domain_force">['|', ('transfer_id.company_id', 'in', company_ids), ('transfer_id.dest_company_id', 'in', company_ids)]</field>
    </record>
</odoo>
